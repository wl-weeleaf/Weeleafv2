# Copy to .env for local use. Never commit credentials or upload .env publicly.
# Paste either CORTI_BEARER from Corti CLI or a Models Service API Key.
CORTI_BEARER=
CORTI_REGION=eu
CORTI_ENVIRONMENT=eu
CORTI_BASE_URL=https://ai.eu.corti.app/v1
CORTI_MODEL=corti-s1-mini-instant
# Optional frontier model for Leafy's existing Frontier selection:
CORTI_FRONTIER_MODEL=corti-s1
# Alternative: server-side OAuth client credentials, also emitted by Corti CLI.
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=
CORTI_TENANT=base
